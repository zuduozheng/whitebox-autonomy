# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but allow a non-secret template to be committed
!.env.example

# vercel
.vercel

# editors / IDEs
.idea/
.vscode/
*.iml

# logs
*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local dev
/supabase/.branches
/supabase/.temp

# Locally downloaded NHTSA source CSVs (see migration/nhtsa/pipeline.mjs and
# DATA_PROVENANCE.md) — never committed; each contributor downloads their
# own copy from NHTSA directly.
/data/nhtsa/

# Locally generated pipeline output (dry-run reports, generated SQL,
# exports) — this repository ships pipeline CODE, not its data outputs.
# If a future contribution genuinely needs a small tracked example output,
# add an explicit exception for that one file rather than removing this
# rule.
migration/**/*-output.json
migration/**/*-output.jsonl
migration/**/dry-run*.json
migration/**/dry-run*.jsonl
migration/**/production-export*.json
migration/**/exception-report.json
