# White Box Autonomy — environment template.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in the real
# values from the Supabase dashboard: Project Settings -> API.
#
#   cp .env.example .env.local
#
# Only PUBLIC, READ-ONLY Supabase access is configured here. Both values below
# are safe to expose to the browser:
#
#   * NEXT_PUBLIC_SUPABASE_URL is the project's REST endpoint. It is sent with
#     every request and is not a secret.
#
#   * NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (the "publishable" / anon key) is
#     constrained by PostgreSQL Row-Level Security. On this project RLS is
#     enabled and the only policy grants SELECT on public rows, so this key can
#     read published Observatory records and nothing else. INSERT / UPDATE /
#     DELETE were revoked from the anon and authenticated roles, so it cannot
#     write.
#
# DO NOT add the Supabase service-role / secret key to this project. It bypasses
# RLS, must never reach the browser, and is not required for read-only access.
# If a privileged server-only credential is introduced later it will use a
# non-public name (e.g. SUPABASE_SERVICE_ROLE_KEY) and live only in `.env.local`
# and the hosting provider's server-side environment settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Mapbox GL JS, for the /map page only. This is Mapbox's PUBLIC token (starts
# with "pk."), created at https://account.mapbox.com/access-tokens/ — safe to
# expose to the browser (it is scoped by Mapbox's own token-restriction
# settings, not a secret credential). Client-side map rendering only; Mapbox
# stores none of our data. Without this set, /map renders a notice explaining
# what to configure instead of the map.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
